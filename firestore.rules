rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function chatMember(chatId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }
    function chatAdmin(chatId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.admins;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isMe(uid);
      allow update: if isMe(uid);
      allow delete: if isMe(uid);
    }

    match /chats/{chatId} {
      allow read: if chatMember(chatId);
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if chatMember(chatId);
      allow delete: if chatAdmin(chatId);
      match /messages/{messageId} {
        allow read: if chatMember(chatId);
        allow create: if chatMember(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000;
        allow update, delete: if chatMember(chatId) && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
