rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function chat(chatId) { return get(/databases/$(database)/documents/chats/$(chatId)); }
    function isMember(chatId) { return signedIn() && request.auth.uid in chat(chatId).data.members; }
    function isAdmin(chatId) { return signedIn() && request.auth.uid in chat(chatId).data.admins; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isMe(uid);
      allow update, delete: if isMe(uid);
    }

    match /chats/{chatId} {
      allow read: if isMember(chatId);
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if isAdmin(chatId) || (
        isMember(chatId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','updatedAt','unreadCount'])
      );
      allow delete: if isAdmin(chatId);

      match /messages/{messageId} {
        allow read: if isMember(chatId);
        allow create: if isMember(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && (chat(chatId).data.type != 'channel' || isAdmin(chatId));
        allow update, delete: if isMember(chatId) && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
